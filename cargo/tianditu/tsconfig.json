{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@ardudeck/module-sdk": ["../../packages/module-sdk/src/index.ts"],
      "@ardudeck/module-sdk/esbuild": ["../../packages/module-sdk/src/esbuild.ts"]
    }
  },
  "include": ["src"]
}
